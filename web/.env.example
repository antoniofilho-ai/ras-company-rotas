# Copie para web/.env.local (NAO envie .env.local para GitHub).
# Restrinja a chave a Maps JavaScript API e aos sites autorizados no Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI

# DEMO_MAP_ID: somente testes locais. Crie um Map ID proprio para producao.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# 'hybrid' (imagem de satelite com ruas) ou 'roadmap' (mapa de ruas).
VITE_GOOGLE_MAP_TYPE=hybrid
